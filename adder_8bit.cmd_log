xst -intstyle ise -ifn "/home/rashed/computer/adder_8bit.xst" -ofn "/home/rashed/computer/adder_8bit.syr" 
ngdbuild -intstyle ise -dd _ngo -nt timestamp -i -p xc6slx4-tqg144-3 adder_8bit.ngc adder_8bit.ngd  
map -intstyle ise -p xc6slx4-tqg144-3 -w -logic_opt off -ol high -t 1 -xt 0 -register_duplication off -r 4 -global_opt off -mt off -ir off -pr off -lc off -power off -o adder_8bit_map.ncd adder_8bit.ngd adder_8bit.pcf 
vhdtdtfi -lib work nand_gate.vhd -lib work not_gate.vhd -lib work xor_gate.vhd -lib work and_gate.vhd -lib work or_gate.vhd -lib work half_adder.vhd -lib work full_adder.vhd -lib work adder_4bit.vhd -lib work adder_8bit.vhd -prj computer -o adder_8bit.spl -module adder_8bit -template /opt/Xilinx/14.7/ISE_DS/ISE//data/splfile.tft -deleteonerror 
spl2sym -intstyle ise -family spartan6 adder_8bit.spl /home/ise/vlsi/computer/adder_8bit.sym 
